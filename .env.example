APP_BASE_URL=http://localhost:3000

DATABASE_URL="file:./local.db"
# The SQLite file will be created when you run migrations.
# In Dokploy, use a volume-backed path such as `file:/data/app.db`.

# pnpm run auth:secret
BETTER_AUTH_SECRET=

# Runtime email delivery config
CONTACT_TO_EMAIL=me@mikecebul.com
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025

# OAuth2 providers, optional, update as needed
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NOTE:
# APP_BASE_URL must match the public URL of your deployed app in production.
# In your OAuth2 apps, set callback/redirect URIs to `http://localhost:3000/api/auth/callback/<provider>`
# e.g. http://localhost:3000/api/auth/callback/github
# In development, start Mailpit with `docker compose up -d` and review captured emails at http://localhost:8025
